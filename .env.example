# Copy to .env and adjust. Read by both the Python tests (tests/conftest.py via
# python-dotenv) and the C++ benchmarks (core/benchmarks/dotenv.hpp).
#
# Paths are relative to the repository root for both runtimes. A real
# environment variable set inline (e.g. `ORT_INTRA_OP_THREADS=4 pytest ...`)
# overrides the value here.

# Model directory and the ONNX file inside it to benchmark. The model is loaded
# as <MODEL_DIR>/<MODEL_FILE>. download_model.sh places fp32 + INT8 builds flat
# in MODEL_DIR, so switching to INT8 is just a MODEL_FILE change here:
#   model.onnx                    fp32 baseline
#   model_qint8_arm64.onnx        INT8, Apple/ARM (local dev)
#   model_qint8_avx512_vnni.onnx  INT8, Intel with VNNI (prod)
#   model_quint8_avx2.onnx        INT8, Intel AVX2 only
MODEL_DIR=models/paraphrase-multilingual-MiniLM-L12-v2
MODEL_FILE=model.onnx

# Dataset used by the benchmarks.
DATASET_PATH=eval_data/spam_paraphrases.jsonl

# ONNX Runtime threading. 0 means "let ORT decide" (all cores).
ORT_INTRA_OP_THREADS=0
ORT_INTER_OP_THREADS=0

# Python-only: ONNX Runtime execution providers, comma-separated.
# e.g. CoreMLExecutionProvider,CPUExecutionProvider
ORT_PROVIDERS=CPUExecutionProvider

# C++-only knobs mirrored from EmbeddingModelConfig.
NORMALIZE_EMBEDDINGS=false
ORT_ENABLE_MEM_PATTERN=true
